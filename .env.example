# Copy to .env and fill in
GROQ_API_KEY=            # free key from console.groq.com
PORT=3000

# --- Accounts ---
SESSION_SECRET=          # long random string, e.g. `openssl rand -hex 32`. Keeps sign-ins valid across deploys
BASE_URL=                # public URL, e.g. https://convos-fm71.onrender.com (used for the OAuth redirect URIs)
# ADMIN_EMAIL=           # this account inherits surveys created before accounts existed (else the first account to sign up does)

# --- Google sign-in (optional; button appears when both are set) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#   Redirect URI to register: <BASE_URL>/auth/google/callback

# --- Microsoft sign-in (optional; button appears when both are set) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common   # common = work/school + personal accounts
#   Redirect URI to register: <BASE_URL>/auth/microsoft/callback

# --- Storage (IMPORTANT on Render) ---
# DATA_DIR=./data        # SQLite database (users, surveys, responses) and audio. MUST be on a persistent disk in production
# TRUST_PROXY=1          # set when behind a reverse proxy / PaaS
# NODE_ENV=production
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3-turbo
